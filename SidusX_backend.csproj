<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SidusX</RootNamespace>
    <AssemblyName>SidusX_backend</AssemblyName>
    <UserSecretsId>SidusX-backend-secrets</UserSecretsId>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL via Dapper -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Npgsql" Version="9.0.4" />

    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.9.0" />
    <PackageReference Include="MimeKit" Version="4.9.0" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />

    <!-- Hardware/system info -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.551801" />
  </ItemGroup>

</Project>
