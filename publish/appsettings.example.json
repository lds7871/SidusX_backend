{
  "Application": {
    "Name": "SidusX_backend",
    "Port": 8100
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=postgres;Username=postgres;******"
  },
  "Security": {
    "IpWhitelistEnabled": true,
    "IpWhitelist": [
      "127.0.0.1",
      "::1",
      "localhost",
      "0:0:0:0:0:0:0:1",
      "YOUR_SERVER_IP",
      "YOUR_HOME_IP"
    ],
    "PassTokenEnabled": true,
    "PassTokens": ""
  },
  "Mail": {
    "Smtp": {
      "Host": "smtp.qq.com",
      "Port": 587,
      "Username": "YOUR_EMAIL@qq.com",
      "Password": "YOUR_EMAIL_PASSWORD",
      "From": "YOUR_EMAIL@qq.com",
      "Timeout": 5000,
      "UseSsl": false,
      "UseStartTls": true
    }
  },
  "Proxy": {
    "IsOpen": false,
    "Host": "127.0.0.1",
    "Port": 33210,
    "SocksPort": 33211
  },
  "WebSocketConsole": {
    "Enabled": true,
    "Endpoint": "/ws/console",
    "Password": "",
    "MaxTextMessageBufferSize": 512000,
    "MaxBinaryMessageBufferSize": 512000,
    "MessageQueueSize": 1000,
    "HistoryBufferSize": 100
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SidusX": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "IdleTimeout": 1800,
    "CookieName": "JSESSIONID",
    "HttpOnly": true,
    "Secure": false
  }
}